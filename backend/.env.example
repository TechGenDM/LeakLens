# Prior Labs TabPFN API Credentials
# Get your free API key at https://app.priorlabs.ai/
PRIORLABS_API_KEY=tabpfn_sk_your_key_here
TABPFN_TOKEN=tabpfn_sk_your_key_here

# Open-Weight LLM Action Agent (Groq / Ollama)
# Get your free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Local Ollama URL (default: http://localhost:11434)
OLLAMA_API_URL=http://localhost:11434

# Execution Mode:
# 'local'  -> Runs local open-weights TabPFN on CPU/GPU
# 'client' -> Runs TabPFN-3.5 on Prior Labs cloud API (ideal for 512MB RAM Render tiers)
TABPFN_MODE=local
